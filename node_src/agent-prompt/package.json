{
  "name": "@dsh-external/dotdsh-agent-prompt",
  "version": "0.1.0",
  "description": "dotdsh agent-prompt: one global system-prompt section telling every agent how to wait for a delegated subagent — the settlement wakes an idle session with a new turn, so no sleep timers or repeated status checks",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node test/verify-section.mjs",
    "prepublishOnly": "pnpm build"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0"
  }
}
