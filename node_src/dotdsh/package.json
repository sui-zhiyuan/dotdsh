{
  "name": "@dsh-external/dotdsh",
  "version": "0.1.0",
  "description": "dotdsh plugin store: one dsh patch layer driven by applist.yaml, inserting my plugin list into the dsh plugin tree",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
